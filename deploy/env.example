# word-Dance configuration — copied by deploy/install.sh to $WD_DATA_DIR/.env (0600) and then NEVER overwritten.
# Reference: docs/DEPLOY.md §4 (every variable below with its default). Secrets never leave this file.
#
# QUOTING RULE (binding): this one file is read by THREE parsers — bash (`set -a; . .env` in install.sh), systemd
# `EnvironmentFile=` and python-dotenv (`wd` CLI / dev / tests) — whose rules for UNQUOTED values differ (bash would
# EXECUTE `low` for `WD_AI_EXTRA_ARGS=--effort low`). Therefore every non-comment line is
#     KEY="value"     (double quotes; all three parsers read it identically, e.g. WD_AI_EXTRA_ARGS="--effort low")
#     KEY='value'     (single quotes, literal in all three — for a value that contains " (WD_AI_FALLBACK_PRICE_JSON) or a secret that contains $ ` or \)
# `#` starts a comment only at the beginning of a line. install.sh runs `bash -n` plus a line-shape check
# (^WD_[A-Z0-9_]+=("[^"$`\\]*"|'[^']*')$) before sourcing the file and aborts with the offending line(s).
# An empty value ("") means "use the built-in default" shown in the comment.

# ---------------------------------------------------------------------------------------------------- paths / network
# runtime state (database, images, backups, this file); 0700, outside the git checkout — install.sh fills it in
WD_DATA_DIR="/home/sqin/word-dance-data"
# SQLite file (empty = $WD_DATA_DIR/word-dance.db)
WD_DB_PATH=""
# bind address and port; 127.0.0.1 behind a reverse proxy (set by install.sh --with-caddy / --with-nginx)
WD_HOST="0.0.0.0"
WD_PORT="8000"
# base of e-mail/webhook links, also an accepted CSRF Origin and the source of cookie `Secure` (https).
# install.sh writes http://<first LAN IP>:<WD_PORT> here when no proxy is configured and https://<domain> with one.
WD_PUBLIC_URL=""
# the shipped vocabulary seed (empty = <repo>/data/seed/vocab.jsonl.gz; set it for a non-editable install)
WD_SEED_PATH=""
# built SPA served by the backend (empty = <repo>/frontend/dist, the dev build). install.sh fills $WD_DATA_DIR/frontend, the
# symlink to the snapshot it publishes under frontend-releases/<sha> — so builds in the checkout never touch the live UI (DEPLOY §1)
WD_FRONTEND_DIST=""
# 1 = trust X-Forwarded-For / X-Forwarded-Proto from the local reverse proxy (uvicorn forwarded_allow_ips=127.0.0.1); the client
#     IP is then the hop the proxy APPENDED, never the first hop the client itself sent (set by install.sh with a proxy)
WD_TRUST_PROXY="0"
# auto = Secure cookies when WD_PUBLIC_URL is https; 1 forces Secure; 0 disables it
WD_COOKIE_SECURE="auto"
# 1 = OpenAPI docs at /api/docs, http://localhost:5173 origin allowed, POST /api/admin/jobs/run-once (dev only)
WD_DEV="0"
# HMAC key for the verification codes (login_codes: phone / e-mail codes, stale-phone challenges, captchas) — generated by
# install.sh (openssl rand -hex 32); must be non-empty; rotating it only invalidates unexpired codes
WD_SECRET_KEY=""
# operational timezone: AI budget day, maintenance 03:30, backup names, admin views (users push in their own zone)
WD_TZ="Asia/Shanghai"
# open / invite / closed / verified — the very first account is always admin without a code (username + password, any mode).
# verified = a phone or e-mail verification code creates the account (docs/AUTH_SIGNUP_DESIGN.md): username + password only as a
# login / extra method, the invite code optional; needs WD_SMS_PROVIDER and/or a mail provider (the sign-in block below) and
# the per-user AI quota WD_AI_USER_DAILY_WORDS before the site opens to strangers
WD_REGISTRATION_MODE="invite"
WD_SESSION_DAYS="30"
WD_MAX_BODY_BYTES="1048576"
# 1 = run the scheduler and job workers inside `wd serve` (0 only in tests/smoke)
WD_WORKER_ENABLED="1"
WD_TICK_SECONDS="60"
WD_PREBUILD_HOURS="3"
# contact address in the Wikimedia User-Agent (empty = admin@localhost); install.sh asks or takes --contact-email
WD_CONTACT_EMAIL=""

# ---------------------------------------------------------------------------------------------------- Claude Code CLI
# absolute path of the authenticated `claude` binary — install.sh writes `command -v claude` (a relative path with `/` is
# made absolute against the start-up working directory: the CLI runs in WD_CLAUDE_CWD)
WD_CLAUDE_BIN="/home/sqin/.local/bin/claude"
# child environment of `claude -p` (CLAUDE_INTEGRATION §1.3): HOME (empty = the service user's $HOME), PATH, empty cwd
WD_CLAUDE_HOME=""
WD_CLAUDE_PATH="/home/sqin/.local/bin:/usr/local/bin:/usr/bin:/bin"
WD_CLAUDE_CWD=""
# kill switch for every Claude call (jobs stay queued; the UI runs on dictionary data)
WD_AI_ENABLED="1"
WD_AI_MODEL="sonnet"
# the CLI's own --fallback-model (Claude -> Claude, empty = off; it was WD_AI_FALLBACK_MODEL before migration 0010 — that key now
# names the fallback PROVIDER's model, see the fallback block below) and extra CLI flags appended verbatim, e.g. "--effort low"
WD_AI_CLI_FALLBACK_MODEL=""
WD_AI_EXTRA_ARGS=""
# words per content call (clamped 1–12: content_v1.json has items.maxItems 12) and parallel Claude workers (1–3)
WD_AI_BATCH_SIZE="10"
WD_AI_CONCURRENCY="1"
# per-call timeouts in seconds
WD_AI_TIMEOUT_CONTENT_SEC="180"
WD_AI_TIMEOUT_LOOKUP_SEC="120"
WD_AI_TIMEOUT_CONSOLIDATE_SEC="240"
WD_AI_TIMEOUT_SVG_SEC="120"
WD_AI_TIMEOUT_DANCE_SEC="120"
# --max-budget-usd per call
WD_AI_BUDGET_CONTENT="0.25"
WD_AI_BUDGET_LOOKUP="0.15"
WD_AI_BUDGET_CONSOLIDATE="0.40"
WD_AI_BUDGET_SVG="0.10"
WD_AI_BUDGET_DANCE="0.25"
# spend caps (measured $0.004/word → ≈ 750 words/day at 3.00)
WD_AI_DAILY_BUDGET_USD="3.00"
WD_AI_MONTHLY_BUDGET_USD="40.00"
WD_AI_PREWARM_DAILY_BUDGET_USD="1.00"
WD_AI_HOURLY_CALL_CAP="60"
# daily sub-cap for Claude-drawn SVG concept cards (≈ $0.0124 per call, $0.0140 per delivered card → ≈ 35–40 cards/day); 0 disables SVG generation only
WD_AI_SVG_DAILY_BUDGET_USD="0.50"
# daily sub-cap for 单词之舞 Claude annotations (generate_dance, 20 words per call ≈ $0.07 → ≈ 140 words/day); 0 disables the annotations only
WD_AI_DANCE_DAILY_BUDGET_USD="0.50"
# raw claude stdout/stderr under claude-logs/ for N days
WD_AI_LOG_KEEP_DAYS="14"
# optional full ECDICT stardict.db (851 MB) for instant lookups outside the seed — deploy/fetch_ecdict.sh sets it
WD_ECDICT_DB_PATH=""

# ---------------------------------------------------------------------------------------------------- fallback provider (docs/AI_FALLBACK_MODEL.md)
# claude_cli = the CLI only (today's behaviour) · openai_http = the fallback HTTP provider only · auto = the CLI with automatic
# failover to the fallback and fail-back by probe (CLAUDE_INTEGRATION §10) · split = the learners' kinds (WD_AI_FALLBACK_KINDS, prewarm
# groups excepted) on the fallback, the operator's work (prewarm content, svg, dance) on the CLI, no switching either way.
# openai_http / auto / split refuse to start unless KIND, BASE_URL, MODEL and a key (or key file) are set. In openai_http mode ONLY the kinds listed in WD_AI_FALLBACK_KINDS ever run: with the default
# list (content,lookup,consolidate) only SVG cards — which the fallback never draws — and prewarm content groups (priority >= 90, unless
# WD_AI_FALLBACK_PREWARM=1; a plan started before the switch keeps fanning them out) wait indefinitely; remove content from the list
# and every content job waits too and learners get dictionary data (the service then starts with a warning naming the removed kinds,
# not an error — the prewarm gate is not part of that warning)
WD_AI_PROVIDER="claude_cli"
# none / openai_http (an OpenAI-format POST {base}/chat/completions endpoint)
WD_AI_FALLBACK_KIND="none"
# e.g. Zhipu https://open.bigmodel.cn/api/paas/v4 · Alibaba Bailian https://dashscope.aliyuncs.com/compatible-mode/v1 (trailing / stripped).
# Must start with http:// or https:// and name a host (the service refuses to start otherwise — a scheme-less value would fail every
# call as a soft network error instead); plain http:// to a host other than loopback starts with a warning (the key travels in cleartext)
WD_AI_FALLBACK_BASE_URL=""
# bearer key: prefer the 0600 file (its first line is read at call time); the inline value is masked by GET /api/admin/config.
# A key file must exist and be a readable regular file at startup (the service refuses to start and names the path otherwise);
# a group/other-readable mode only logs a warning — chmod 600 it
WD_AI_FALLBACK_API_KEY=""
WD_AI_FALLBACK_API_KEY_FILE=""
# vendor model id, e.g. glm-4.7-flash (Zhipu free tier) or qwen3.7-flash (Bailian, paid)
WD_AI_FALLBACK_MODEL=""
# request shape: dialect auto is derived from the host (zhipu / bailian / deepseek / generic); JSON mode auto = json_object with the
# schema in the system prompt (json_schema for Bailian); thinking off sends the vendor's disable-thinking field (on / default)
WD_AI_FALLBACK_DIALECT="auto"
WD_AI_FALLBACK_JSON_MODE="auto"
WD_AI_FALLBACK_THINKING="off"
# the kind's timeout × scale (0.5–5.0); max_tokens override (0 = the adapter's per-kind table); the fallback's own hourly call cap
WD_AI_FALLBACK_TIMEOUT_SCALE="1.5"
WD_AI_FALLBACK_MAX_OUTPUT_TOKENS="0"
WD_AI_FALLBACK_HOURLY_CALL_CAP="40"
# words per content call while the fallback takes the group (clamped 1–12 like WD_AI_BATCH_SIZE; the effective size is the smaller of
# the two — content is claimed that way when the fallback would take it, and a larger group claimed for the CLI is regrouped before it
# reruns there; CLAUDE_INTEGRATION §10.5)
WD_AI_FALLBACK_BATCH_SIZE="5"
# job kinds allowed on the fallback (comma list out of content,lookup,consolidate; never svg; empty or blank = the default; remove content
# to keep example generation on the CLI only) and whether prewarm jobs may use it (0: prewarm content waits for the CLI — a claim that
# mixed prewarm and ordinary content is split first; in openai_http mode, where the CLI is never spawned, prewarm content waits indefinitely).
# auto: a kind outside the list stays on the CLI (and waits while the CLI is paused); openai_http: it never runs; split: it runs on the CLI
# with the learners' input (the service warns at startup) — see WD_AI_PROVIDER
WD_AI_FALLBACK_KINDS="content,lookup,consolidate"
WD_AI_FALLBACK_PREWARM="0"
# CNY per million tokens, e.g. WD_AI_FALLBACK_PRICE_JSON='{"input": 0.2, "output": 0.8}' (single quotes: the value contains ");
# the names are exactly input and output (both required when the object is not empty) plus an optional cache_read — anything else
# refuses to start, since a mis-keyed table would record cost_usd 0 for a paid leg; empty or {} = free tier (cost_usd 0).
# WD_AI_CNY_PER_USD converts the price table into the USD ledger
WD_AI_FALLBACK_PRICE_JSON=""
WD_AI_CNY_PER_USD="7.2"
# provider pauses and switch rules, minutes. WD_AI_FAILOVER_COOLDOWN_MIN: the pause after a hard failure (auth / spawn_error / 403 — in
# EVERY mode; balance 24 h, quota until its window resets) and the fallback's pause after its third consecutive invalid answer (the
# quality pause — auto, openai_http and split alike; lifted only by a fallback probe, an applied fallback group or the admin's resume).
# Mode auto only: the fail-back probe interval, then the consecutive overloaded / timeout / network failures of the CLI before the
# group reruns on the fallback (DEPLOY §4, CLAUDE_INTEGRATION §10.4)
WD_AI_FAILOVER_COOLDOWN_MIN="30"
WD_AI_FAILOVER_PROBE_EVERY_MIN="30"
WD_AI_FAILOVER_OVERLOADED_AFTER="3"
WD_AI_FAILOVER_TIMEOUT_AFTER="2"
WD_AI_FAILOVER_NETWORK_AFTER="2"

# ---------------------------------------------------------------------------------------------------- images
WD_IMAGES_ENABLED="1"
# ordered provider chain; pixabay / pexels are appended automatically when their keys are set
WD_IMAGE_PROVIDERS="wikimedia,openverse"
# stage codes whose words get the child style and the illustration-first round (empty = off; production sets xs — 小学 cards are drawn in the child style; zk is never in the default)
WD_IMAGE_KID_STAGES=""
# 1 = Claude-drawn SVG card when no acceptable photo exists (for words a user studies); 0 = photos or the template card only
WD_SVG_VIA_CLAUDE="1"
WD_IMAGE_MAX_BYTES="8000000"
WD_IMAGE_MAX_EDGE="800"
# politeness limits (Wikimedia 1 req/s; Openverse anonymous limits are 20/min, 200/day)
WD_WIKIMEDIA_MIN_INTERVAL_MS="1000"
WD_WIKIMEDIA_DAILY_LIMIT="2000"
WD_OPENVERSE_MINUTE_LIMIT="15"
WD_OPENVERSE_DAILY_LIMIT="160"
# optional registered Openverse application (raises the limits) and optional keyed providers
WD_OPENVERSE_CLIENT_ID=""
WD_OPENVERSE_CLIENT_SECRET=""
WD_PIXABAY_KEY=""
WD_PEXELS_KEY=""

# ---------------------------------------------------------------------------------------------------- pronunciation audio
# server-side clips for devices without an English voice (Android WebView, the Android container of HarmonyOS NEXT, domestic ROMs):
# auto (the default) = say when /usr/bin/say exists on this host (a Mac), else off · say = macOS say + afconvert (offline, AAC) ·
# youdao = the unofficial dict.youdao.com/dictvoice endpoint (mp3; opt-in — every uncached text is sent there) · bailian = 阿里云百炼
# CosyVoice / Qwen-Audio cloud TTS (mp3; paid, the WD_BAILIAN_* block below — the licensed voice for a public deployment or a Linux
# server; never picked by auto) · cache = a read-only mirror of the say clips another host made (WD_AUDIO_CACHE_VOICES below; a text
# without a clip is 503 {reason:"missing"}) · off = the endpoint answers 503 and every client keeps its own voice. A Linux VPS has no
# fallback until this is set — bailian, cache or youdao (DEPLOY §4).
WD_AUDIO_PROVIDER="auto"
# the `say -v` voice for both accents, as `say -v '?'` lists it (e.g. "Ava (Premium)" after downloading it; needs a restart; `wd audio-voices` lists what resolves);
# empty (the default) = the best installed voice per accent, Premium > Enhanced > compact. A name say does not know is a 503, never
# clips in another voice
WD_AUDIO_SAY_VOICE=""
# with WD_AUDIO_PROVIDER="cache" (a Linux server playing the clips a Mac synthesised and rsynced into audio/): the voices those
# clips were made with, per accent, exactly as `say -v '?'` prints them on that Mac (`wd audio-voices` there); both accents required
WD_AUDIO_CACHE_VOICES=""
# cap of the clip cache under $WD_DATA_DIR/audio in MB (default 256, min 16); least recently played clips are removed beyond it
WD_AUDIO_CACHE_MB="256"

# ---------------------------------------------------------------------------------------------------- pronunciation: 百炼 cloud TTS (slice server-audio-2)
# WD_AUDIO_PROVIDER="bailian" (阿里云百炼 CosyVoice / Qwen-Audio TTS, synchronous HTTP API). Why: the macOS SLA keeps the `say` voices
# personal and non-commercial, and a Linux server has no `say` — a public deployment needs a licensed cloud voice. Price: cosyvoice-v3-flash
# 1 元 per 10 000 characters (≈ ¥115 for the whole library's words and example sentences), 180 requests per minute (the server paces itself).
# path of a 0600 file whose first line is the 百炼 API key (sk-…, shown once at creation; read at call time; must exist and be readable
# at startup, a group/other-readable mode only warns — chmod 600 it). Required with bailian; never an inline variable
WD_BAILIAN_API_KEY_FILE=""
# the 业务空间 id (百炼控制台 → 业务空间管理) — the TTS host is {WorkspaceId}.{region}.maas.aliyuncs.com; required with bailian
WD_BAILIAN_WORKSPACE_ID=""
# cn-beijing (华北2 北京: the CosyVoice system English voices) or ap-southeast-1 (新加坡: qwen-audio-3.1-tts-flash's 精品英文音色);
# keys, models and voices are per region and never cross
WD_BAILIAN_REGION="cn-beijing"
# optional full endpoint override (a test mock, a future host); empty = https://{WorkspaceId}.{region}.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer.
# Must start with http:// or https:// and name a host; plain http:// to a non-loopback host starts with a warning (the key travels in cleartext)
WD_BAILIAN_TTS_URL=""
# the model: cosyvoice-v3-flash (1 元/万字符, voices loong*_v3) or qwen-audio-3.1-tts-flash (same endpoint, billed per token, voices *_v3.1)
WD_BAILIAN_TTS_MODEL="cosyvoice-v3-flash"
# one voice per accent of the model above, in the WD_AUDIO_CACHE_VOICES shape (CosyVoice v3: loongabby_v3 美式女 / loongandy_v3 美式男 /
# loongemily_v3 英式女 / loongeric_v3 英式男); both accents required with bailian. The voice is part of every clip's name: a new voice means
# new clips (the old ones age out under WD_AUDIO_CACHE_MB, or `wd audio-prewarm --purge-others` drops them) and a new audio_key for the browsers
WD_BAILIAN_TTS_VOICES="en-US=loongabby_v3;en-GB=loongemily_v3"

# ---------------------------------------------------------------------------------------------------- e-mail (optional)
# smtp = the WD_SMTP_* server below (the e-mail channel is enabled when host + from are set) · aliyun_dm = Aliyun DirectMail over
# HTTPS with the WD_ALIYUN_* key of the sign-in block and WD_SMTP_FROM as the verified sender (refuses to start without all three)
WD_MAIL_PROVIDER="smtp"
# TLS: starttls / ssl / none. WD_SMTP_FROM is the sender address of BOTH providers
WD_SMTP_HOST=""
WD_SMTP_PORT="587"
WD_SMTP_USER=""
WD_SMTP_PASSWORD=""
WD_SMTP_FROM=""
WD_SMTP_TLS="starttls"

# ---------------------------------------------------------------------------------------------------- sign-in by verification code (docs/AUTH_SIGNUP_DESIGN.md)
# off = no SMS: the login page offers e-mail and password only · aliyun_verify = Aliyun 号码认证 SendSmsVerifyCode (system signature,
# built-in templates); refuses to start unless the three WD_ALIYUN_* values below are set. `wd sms-probe <number>` sends one real code
WD_SMS_PROVIDER="off"
# RAM user AccessKey ID shared by aliyun_verify and aliyun_dm (masked by GET /api/admin/config)
WD_ALIYUN_ACCESS_KEY_ID=""
# path of a 0600 file whose first line is the AccessKey secret (read at call time; must exist and be readable at startup,
# a group/other-readable mode only warns — chmod 600 it). Never an inline variable
WD_ALIYUN_ACCESS_KEY_SECRET_FILE=""
# the system signature name shown in the 号码认证 console (the SendSmsVerifyCode SignName); required by aliyun_verify
WD_ALIYUN_SMS_SIGN_NAME=""
# site-wide SMS caps: codes per WD_TZ day (0 = phone codes off for the day budget; new-account sends stop at 70 %, admins are
# notified at 80 % and 100 %) and per UTC hour — beyond them 503 sms_budget_exhausted (DEPLOY §4)
WD_SMS_DAILY_CAP="200"
WD_SMS_HOURLY_CAP="40"
# verification-code sends per client IP per hour (the per-target 1/min, 5/h, 10/day limits are fixed in security.py)
WD_CODE_IP_HOURLY="20"
# a phone identity without a code login for this many days gets the stale-phone challenge (password or e-mail code; 「不是我的」
# disputes the binding) instead of a session
WD_PHONE_STALE_DAYS="90"
# on / off — the self-hosted image captcha in front of the PUBLIC code sends (no session); logged-in sends and the password login
# never ask for it. Tests set off
WD_CAPTCHA="on"
# per-learner AI quota: words one user may cause content generation for per UTC day (0 = unlimited); beyond it the learner's marks
# and 「生成例句」 requests are served from dictionary data until tomorrow — the precondition of WD_REGISTRATION_MODE="verified" (D2)
WD_AI_USER_DAILY_WORDS="80"

# ---------------------------------------------------------------------------------------------------- third-party sign-in (slice 2-A, docs/AUTH_SIGNUP_DESIGN.md §5.3)
# Everything here ships dark: with the three provider blocks empty nothing changes for users (no login-page row, the endpoints answer
# 409 provider_unconfigured). An appid without its secret file / callback refuses to start. The secret FILE paths are not secrets
# (GET /api/admin/config shows them); the files' first lines are — 0600, read at call time, never in this file.
# WeChat mini program (API.md 112–116): the AppID and a 0600 file whose first line is the AppSecret; both set = the bridge is on
WD_WECHAT_APPID=""
WD_WECHAT_SECRET_FILE=""
# release / trial / develop — the env_version of the 小程序码 (develop / trial while the mini program is not published yet)
WD_WECHAT_ENV="release"
# the mini-program page the 小程序码 opens (miniprogram/app.json)
WD_WECHAT_PAGE="pages/confirm/confirm"
# QQ 互联 网站应用 (API.md 118 / 119): APP ID, a 0600 file whose first line is the APP Key, and the registered callback
# https://<filed domain>/api/auth/qq/callback (the mainland relay host proxies it to this server, deploy/relay/README.md); all three = on.
# Callbacks must be https:// (http:// only with WD_DEV="1")
WD_QQ_APPID=""
WD_QQ_KEY_FILE=""
WD_QQ_CALLBACK_URL=""
# Sign in with Apple, web redirect flow (API.md 120 / 121): the Services ID and the Return URL https://<host>/api/auth/apple/callback
# registered for it; both = on. WD_APPLE_APP_ID (the iOS bundle id, also accepted as `aud`) is read but unused until the iOS plugin exists
WD_APPLE_CLIENT_ID=""
WD_APPLE_APP_ID=""
WD_APPLE_CALLBACK_URL=""

# ---------------------------------------------------------------------------------------------------- logging / backups / admin
# DEBUG / INFO / WARNING / ERROR / CRITICAL; json (journald) or text; optional rotating file (50 MB × 5)
WD_LOG_LEVEL="INFO"
WD_LOG_FORMAT="json"
WD_LOG_FILE=""
# retention of `wd backup` (the timer passes the same numbers explicitly)
WD_BACKUP_KEEP_DAILY="14"
WD_BACKUP_KEEP_WEEKLY="8"
# unattended first admin for `wd create-admin --if-none`; remove the password afterwards
WD_ADMIN_USERNAME=""
WD_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------------------------------- development only
# scripts/dev.sh: 1 = use the real `claude` CLI instead of backend/tests/fake_claude.py (spends money)
WD_DEV_REAL_CLAUDE="0"
# tests/smoke only: 1 = image-provider HTTP goes through httpx.MockTransport fixtures
WD_SMOKE_MOCK_HTTP="0"
# dev only (refuses to start without WD_DEV="1"): 1 = the fake WeChat / QQ / Apple clients and the fake consent pages /api/auth/fake/*,
# so the three third-party sign-in flows run end to end without credentials (make smoke, a developer's browser); nothing leaves the box
WD_AUTH_FAKE_PROVIDERS="0"
