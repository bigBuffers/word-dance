# EditorConfig — https://editorconfig.org
# Python follows PEP 8 (4 spaces); everything else (TS/TSX, CSS, JSON, SQL,
# YAML, shell) uses 2 spaces; Makefiles need tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab

[*.{md,markdown}]
# two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false

[*.jsonl]
# generated by scripts/build_seed.py — never reformat
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
