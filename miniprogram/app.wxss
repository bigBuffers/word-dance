page { background: #f6f7f9; color: #1d2733; font-size: 30rpx; }
.page { padding: 40rpx 36rpx 60rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 36rpx 32rpx; box-shadow: 0 4rpx 20rpx rgba(31, 78, 121, 0.08); }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 24rpx; }
.muted { color: #6b7785; font-size: 26rpx; }
.row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #eef1f4; }
.row:last-child { border-bottom: none; }
.row .label { color: #6b7785; }
.row .value { max-width: 60%; text-align: right; word-break: break-all; }
.btn { margin-top: 28rpx; border-radius: 16rpx; font-size: 32rpx; }
.btn-primary { background: #1f4e79; color: #fff; }
.btn-primary[disabled] { background: #b8c4d1; color: #fff; }
.btn-plain { background: #fff; color: #1f4e79; border: 1rpx solid #1f4e79; }
.state { margin: 28rpx 0 8rpx; padding: 20rpx 24rpx; border-radius: 16rpx; background: #eef4fa; color: #1f4e79; }
.state-warn { background: #fdf1e7; color: #b25a12; }
.result { text-align: center; padding: 80rpx 0 40rpx; }
.result .big { font-size: 44rpx; font-weight: 600; margin-bottom: 20rpx; }
