<view class="page">
  <view class="card">
    <view class="title">输入网页上的配对码</view>
    <view class="muted">网页的「微信登录」里有一个 6 位配对码，3 分钟内有效。</view>
    <input class="code" type="number" maxlength="6" placeholder="6 位数字" value="{{code}}" bindinput="onInput" confirm-type="done" bindconfirm="submit" focus="{{true}}" />
    <button class="btn btn-primary" disabled="{{busy || code.length !== 6}}" loading="{{busy}}" bindtap="submit">下一步</button>
  </view>
</view>
