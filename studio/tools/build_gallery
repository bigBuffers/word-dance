#!/bin/sh
# studio/tools/build_gallery — build_gallery.py under the studio's own virtualenv (studio/.venv, see studio/README.md),
# with the repository's backend on PYTHONPATH like studio/tools/check: the page shows every card as the app's own
# sanitiser leaves it. Works from any directory; every path comes from this file's location.
here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
py="$repo/studio/.venv/bin/python"
if [ ! -x "$py" ]; then
  echo "studio/tools/build_gallery: $py not found — create the studio's virtualenv first:" >&2
  echo "  cd $repo && python3.12 -m venv studio/.venv && studio/.venv/bin/pip install -r studio/requirements.txt" >&2
  exit 2
fi
PYTHONPATH="$repo/backend${PYTHONPATH:+:$PYTHONPATH}" exec "$py" "$here/build_gallery.py" "$@"
